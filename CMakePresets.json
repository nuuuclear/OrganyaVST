{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },

    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows - MSVC + Ninja - Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-msvc-debug",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows - MSVC + Ninja - Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-msvc-release",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-gcc",
            "inherits": "base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-clang",
            "inherits": "base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "macos",
            "inherits": "base",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/macos"
        }
    ],

    "buildPresets": [
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc-debug"
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release"
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc"
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang"
        },
        {
            "name": "macos-release",
            "configurePreset": "macos",
            "configuration": "Release"
        }
    ]
}